{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "description": "A model-selected ID enriched only from trusted local retrieval data.",
      "properties": {
        "article_no": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Article No",
          "type": "string"
        },
        "document_name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Document Name",
          "type": "string"
        },
        "provision_id": {
          "exclusiveMinimum": 0,
          "title": "Provision Id",
          "type": "integer"
        }
      },
      "required": [
        "provision_id",
        "document_name",
        "article_no"
      ],
      "title": "Citation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Sanitized outward response suitable for API and UI serialization.",
  "properties": {
    "can_answer": {
      "title": "Can Answer",
      "type": "boolean"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "title": "Citations",
      "type": "array"
    },
    "conditions": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Conditions",
      "type": "array"
    },
    "exceptions": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Exceptions",
      "type": "array"
    },
    "missing_information": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Missing Information",
      "type": "array"
    },
    "notice": {
      "default": "本回答僅供內部初步法規解析，不構成正式法律意見。",
      "title": "Notice",
      "type": "string"
    },
    "summary": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "can_answer",
    "summary"
  ],
  "title": "LegalQaResponse",
  "type": "object"
}

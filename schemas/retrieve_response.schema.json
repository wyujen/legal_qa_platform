{
  "$defs": {
    "RetrievalResult": {
      "additionalProperties": false,
      "description": "Locally enriched hybrid result returned by the application core.",
      "properties": {
        "article_no": {
          "minLength": 1,
          "title": "Article No",
          "type": "string"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "document_name": {
          "minLength": 1,
          "title": "Document Name",
          "type": "string"
        },
        "embedding_input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Embedding Input Hash",
          "type": "string"
        },
        "final_score": {
          "title": "Final Score",
          "type": "number"
        },
        "keyword_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Keyword Score",
          "type": "number"
        },
        "provision_id": {
          "exclusiveMinimum": 0,
          "title": "Provision Id",
          "type": "integer"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "record_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Record Hash",
          "type": "string"
        },
        "source_url": {
          "default": "",
          "title": "Source Url",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "vector_score": {
          "title": "Vector Score",
          "type": "number"
        }
      },
      "required": [
        "provision_id",
        "document_name",
        "article_no",
        "content",
        "content_hash",
        "record_hash",
        "embedding_input_hash",
        "vector_score",
        "keyword_score",
        "final_score",
        "rank"
      ],
      "title": "RetrievalResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "duration_ms": {
      "minimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "normalized_question": {
      "title": "Normalized Question",
      "type": "string"
    },
    "profile": {
      "title": "Profile",
      "type": "string"
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "retrieval_results": {
      "items": {
        "$ref": "#/$defs/RetrievalResult"
      },
      "title": "Retrieval Results",
      "type": "array"
    },
    "stage_latencies_ms": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Stage Latencies Ms",
      "type": "object"
    }
  },
  "required": [
    "question",
    "normalized_question",
    "profile",
    "retrieval_results",
    "duration_ms"
  ],
  "title": "RetrieveResponse",
  "type": "object"
}
